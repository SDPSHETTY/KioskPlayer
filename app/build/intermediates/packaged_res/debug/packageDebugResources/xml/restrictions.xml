<?xml version="1.0" encoding="utf-8"?>
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <restriction
        android:key="video_dir"
        android:title="Video Directory"
        android:restrictionType="string"
        android:defaultValue="Movies" />

    <restriction
        android:key="play_mode"
        android:title="Play Mode"
        android:restrictionType="choice"
        android:entries="@array/play_mode_entries"
        android:entryValues="@array/play_mode_values"
        android:defaultValue="playlist" />

    <restriction
        android:key="single_file"
        android:title="Single File"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="playlist_files"
        android:title="Playlist Files"
        android:restrictionType="string"
        android:defaultValue="" />

    <restriction
        android:key="loop_mode"
        android:title="Loop Mode"
        android:restrictionType="choice"
        android:entries="@array/loop_mode_entries"
        android:entryValues="@array/loop_mode_values"
        android:defaultValue="loop_all" />

    <restriction
        android:key="fullscreen"
        android:title="Fullscreen"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="hide_controls"
        android:title="Hide Controls"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="orientation"
        android:title="Orientation"
        android:restrictionType="choice"
        android:entries="@array/orientation_entries"
        android:entryValues="@array/orientation_values"
        android:defaultValue="landscape" />

    <restriction
        android:key="mute"
        android:title="Mute"
        android:restrictionType="bool"
        android:defaultValue="false" />

    <restriction
        android:key="volume_percent"
        android:title="Volume Percent"
        android:restrictionType="integer"
        android:defaultValue="100" />

    <restriction
        android:key="autostart_on_boot"
        android:title="Autostart on Boot"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="skip_missing_files"
        android:title="Skip Missing Files"
        android:restrictionType="bool"
        android:defaultValue="true" />

    <restriction
        android:key="show_debug_overlay"
        android:title="Show Debug Overlay"
        android:restrictionType="bool"
        android:defaultValue="false" />

</restrictions>
